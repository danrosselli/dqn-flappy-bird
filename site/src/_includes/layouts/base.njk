<!doctype html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  {% set pageTitle = title ~ " — " ~ site.title if title else site.title %}
  {% set pageDesc = description or site.description %}
  {% set canonical = site.url ~ (page.url | url) %}
  {% set ogImage = site.url ~ ("/assets/images/screenshot.png" | url) %}

  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <link rel="canonical" href="{{ canonical }}">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ ogImage }}">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDesc }}">
  <meta name="twitter:image" content="{{ ogImage }}">

  <meta name="theme-color" content="#f6f2e9">

  <link rel="icon" type="image/svg+xml" href="{{ '/assets/images/favicon.svg' | url }}">
  <link rel="icon" type="image/png" href="{{ '/assets/images/favicon.png' | url }}">
  <link rel="apple-touch-icon" href="{{ '/assets/images/favicon.png' | url }}">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="{{ '/assets/css/main.css' | url }}">

  <script>document.documentElement.classList.add('js');</script>
</head>
<body class="section-{{ section or 'home' }}">
  <a class="skip-link" href="#main">Skip to content</a>

  <div class="page-shell">
    {% include "components/site-header.njk" %}

    <main id="main" tabindex="-1">
      {{ content | safe }}
    </main>

    {% include "components/site-footer.njk" %}
  </div>

  <script src="{{ '/assets/js/main.js' | url }}" defer></script>
  {% if scripts %}
    {% for src in scripts %}
  <script src="{{ src | url }}" defer></script>
    {% endfor %}
  {% endif %}
</body>
</html>
