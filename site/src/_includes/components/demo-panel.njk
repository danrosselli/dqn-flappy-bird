{# ============================================================
   Live Demo integration point.
   The game is the agent: when the Vite production bundles are
   present (built by CI into /game/{slug}/), one is embedded
   here on demand. The user picks an experiment and clicks Start.
   ============================================================ #}
<div class="demo-frame" data-demo-frame data-experiments="{{ experiments.list | json }}">
  <div class="demo-controls" data-demo-controls>
    <label class="demo-select-label" for="demo-experiment">Experiment</label>
    <select class="demo-select" id="demo-experiment" data-demo-select>
      {% for exp in experiments.list %}
      <option value="{{ exp.slug }}">{{ exp.id }} — {{ exp.title }}</option>
      {% endfor %}
    </select>
    <button class="btn demo-start-btn" data-demo-start type="button">Start</button>
  </div>

  <div class="demo-stage" data-demo-stage>
    <div class="demo-stage-hint" data-demo-hint>
      <p>Select an experiment and click <strong>Start</strong> to launch the agent.</p>
    </div>
    <div class="demo-loading" data-demo-loading hidden>
      <span class="status-dot status-dot--lg" data-mode="demo" aria-hidden="true"></span>
      <p>Loading game bundle…</p>
    </div>
  </div>

  <div class="demo-fallback" data-demo-fallback hidden>
    <div class="demo-fallback-inner">
      <p class="demo-fallback-title">Game bundle not found</p>
      <p>
        The selected experiment has not been built yet. Deploy the site
        with CI to have all experiment bundles built automatically, or
        run one locally:
      </p>
      <p class="demo-fallback-cmd">
        <span class="demo-cmd-label">Run locally:</span>
        <code>cd experiments/001-base && bun run dev</code>
      </p>
      <p>
        <a class="btn btn--ghost" href="{{ site.repo }}" rel="noopener">View the source on GitHub</a>
      </p>
    </div>
  </div>

  <noscript>
    <div class="demo-fallback">
      <div class="demo-fallback-inner">
        <p class="demo-fallback-title">JavaScript is required to run the agent</p>
        <p>The game and the neural network run entirely in the browser (Phaser + TensorFlow.js). You can also clone the repository and run <code>bun run dev</code>.</p>
      </div>
    </div>
  </noscript>
</div>
