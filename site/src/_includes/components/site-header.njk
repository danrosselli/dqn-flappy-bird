<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="{{ '/' | url }}" aria-label="DQN Flappy Bird — home">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="30" height="30" fill="none">
          <rect x="1.5" y="1.5" width="29" height="29" rx="7" stroke="currentColor" stroke-width="1.6"/>
          <path d="M7 19.5c3-6.5 7-9.5 11-9.5 2.6 0 4.6 1.2 6 3.2-1.6-.4-3.2-.2-4.6.7 2 .6 3.4 2 4 4.1-2.5 2.9-6 4.5-9.9 4.5-2.5 0-4.8-.9-6.5-3z" fill="currentColor"/>
          <circle cx="20.4" cy="13.4" r="1.15" fill="#f6f2e9"/>
          <path d="M24.5 16.4l3-1.2-2.6-1.7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="brand-text">
        <span class="brand-name">DQN&nbsp;Flappy&nbsp;Bird</span>
        <span class="brand-status">
          <span class="status-dot" data-mode="{{ site.statusMode }}" aria-hidden="true"></span>
          <span>{{ site.statusLabel }}</span>
          {% if site.statusMode == 'demo' %}<span class="status-tag">demo</span>{% endif %}
        </span>
      </span>
    </a>

    <nav class="main-nav" aria-label="Primary">
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-list">
        <span class="nav-toggle-bars" aria-hidden="true"></span>
        <span class="nav-toggle-label">Menu</span>
      </button>
      <ul class="nav-list" id="nav-list">
        {% for item in nav %}
        {% set isCurrent = page.url and page.url.startsWith(item.match) %}
        <li>
          <a
            href="{{ item.url | url }}"
            class="nav-link{% if item.cta %} nav-cta{% endif %}{% if isCurrent %} is-current{% endif %}"
            {% if isCurrent %}aria-current="page"{% endif %}
          >{{ item.label }}</a>
        </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>
