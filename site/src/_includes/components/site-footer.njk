<footer class="site-footer">
  <div class="footer-grid">
    <div class="footer-brand">
      <p class="footer-title">DQN Flappy Bird</p>
      <p class="footer-blurb">
        A personal reinforcement-learning experiment: an agent that learns to play
        Flappy Bird with Deep Q-Learning, trained entirely in the browser.
        The history of the project is part of the project itself.
      </p>
      <p class="footer-status">
        <span class="status-dot" data-mode="{{ site.statusMode }}" aria-hidden="true"></span>
        {{ site.statusLabel }}{% if site.statusMode == 'demo' %} <span class="status-tag">demo</span>{% endif %}
      </p>
    </div>

    <nav class="footer-col" aria-label="Sections">
      <p class="footer-heading">Sections</p>
      <ul>
        {% for item in nav %}
        <li><a href="{{ item.url | url }}">{{ item.label }}</a></li>
        {% endfor %}
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Repository">
      <p class="footer-heading">Repository</p>
      <ul>
        <li><a href="{{ site.repo }}" rel="noopener">View source on GitHub</a></li>
        <li><a href="{{ site.repo }}/tree/main/experiments" rel="noopener">experiments/</a></li>
        <li><a href="{{ site.repo }}/tree/main/data" rel="noopener">data/</a></li>
        <li><a href="{{ site.repo }}/tree/main/src" rel="noopener">src/ — game & agent</a></li>
        <li><a href="{{ site.repo }}/issues" rel="noopener">Issues</a></li>
      </ul>
    </nav>

    <div class="footer-col">
      <p class="footer-heading">Colophon</p>
      <ul class="footer-mono">
        <li>Static site — Eleventy</li>
        <li>Game — Phaser 3.90</li>
        <li>Agent — TensorFlow.js 4.22</li>
        <li>No tracking, no cookies</li>
      </ul>
    </div>
  </div>

  <div class="footer-base">
    <p>© <span data-year>2026</span> {{ site.author }} — a living record of an ongoing experiment.</p>
    <p class="footer-mono-inline">MIT License · Deployed on GitHub Pages</p>
  </div>
</footer>
