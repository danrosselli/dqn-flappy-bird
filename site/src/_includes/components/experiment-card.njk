{# Expects `exp` — an entry from the experiments data layer. #}
<article class="exp-card{% if exp.placeholder %} exp-card--placeholder{% endif %}">
  <a href="{{ ('/experiments/' ~ exp.slug ~ '/') | url }}">
    <header class="exp-card-head">
      <span class="exp-card-id">#{{ exp.id }}</span>
      {% if exp.placeholder %}<span class="status-tag">placeholder</span>{% endif %}
    </header>
    <h3 class="exp-card-title">{{ exp.title }}</h3>
    {% if exp.objective %}<p class="exp-card-objective">{{ exp.objective }}</p>{% endif %}
    <dl class="exp-card-metrics">
      <div><dt>Best</dt><dd>{{ exp.results.score.best | num if exp.results and exp.results.score else "—" }}</dd></div>
      <div><dt>Average</dt><dd>{{ exp.results.score.average | num if exp.results and exp.results.score else "—" }}</dd></div>
      <div><dt>Episodes</dt><dd>{{ exp.results.training.episodes | num if exp.results and exp.results.training else "—" }}</dd></div>
    </dl>
    <span class="exp-card-more">Open experiment <span aria-hidden="true">→</span></span>
  </a>
</article>
