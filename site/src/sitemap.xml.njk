---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for item in collections.all %}
{% if item.url and not item.data.eleventyExcludeFromCollections %}
  <url>
    <loc>{{ site.url }}{{ item.url | url }}</loc>
    {% if item.data.updated %}<lastmod>{{ item.data.updated | dateISO }}</lastmod>{% elif item.data.date %}<lastmod>{{ item.data.date | dateISO }}</lastmod>{% endif %}
  </url>
{% endif %}
{% endfor %}
</urlset>
